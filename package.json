{
  "name": "blue-matador-mcp-server",
  "version": "1.0.10",
  "description": "Connect Bluematador monitoring to Claude Desktop and Claude Code via MCP server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bluematador-mcp-server": "dist/index.js"
  },
  "homepage": "https://github.com/bluematador/blue-matador-mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluematador/blue-matador-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/bluematador/blue-matador-mcp-server/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "tsc",
    "test": "node --test test/unit/tools.test.js",
    "test:mcp-direct": "node test/integration/test_mcp_direct.js",
    "test:mcp-tools": "node test/integration/test_mcp_tools.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "lint": "echo 'Linting not configured yet'",
    "typecheck": "tsc --noEmit",
    "docs": "tsc && node scripts/generate-tool-reference.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "bluematador",
    "monitoring",
    "aws",
    "azure",
    "claude-desktop",
    "claude-code",
    "alerting",
    "infrastructure"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "icon.svg",
    "README.md",
    "DEV-README.md"
  ],
  "author": "Bluematador",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
